@page "/"

<PageTitle>Home</PageTitle>

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h1 class="mb-4">📝 Welcome to Your ASP.NET Aspire To-Do App</h1>

            <div class="card mb-4">
                <div class="card-body">
                    <p class="card-text">
                        Manage your tasks efficiently with our powerful To-Do application built with ASP.NET Aspire.
                    </p>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">✨ Features</h5>
                            <ul class="list-unstyled">
                                <li>✅ Create, Read, Update, Delete tasks</li>
                                <li>🔴 Set priorities (Low, Medium, High)</li>
                                <li>📅 Add due dates to tasks</li>
                                <li>🔍 Filter by priority and status</li>
                                <li>📊 Sort by date or priority</li>
                                <li>✔️ Mark tasks as complete</li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">🚀 Quick Start</h5>
                            <p>Get started with your to-do list:</p>
                            <ol class="ps-3">
                                <li>Click on "Todos" in the navigation menu</li>
                                <li>Click "+ Add New Todo" button</li>
                                <li>Enter your task title and select priority</li>
                                <li>Click "Save" to add the task</li>
                                <li>Use filters and sorting to organize</li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>

            <div class="text-center mt-4">
                <a href="/todos" class="btn btn-primary btn-lg">Go to My Todos →</a>
            </div>
        </div>
    </div>
</div>
